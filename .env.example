# Token file: tokens live here, one per line. The dashboard and the
# /token-file page both read and write this file.
TOKENS_FILE=tokens.txt

# Optional: if set, the endpoints that can read or write the raw token file
# require this key (sent as the x-token-key header). Strongly recommended,
# because those endpoints expose real tokens.
TOKEN_FILE_KEY=

# Legacy fallback: only used once to seed TOKENS_FILE when that file is empty.
BOT_TOKENS=

AUTO_JOIN=false
VOICE_CHANNEL_IDS=
HOST=0.0.0.0
PORT=3000
MAX_BOTS=0
KEEPALIVE_MS=15000
AUDIO_FILE=./shared_audio.mp3

# Loudness chain.
#
# Match the reference ZIP profile: loud, clean and limiter-safe. The ffmpeg
# volume stage uses a real dB gain, and the limiter keeps the final peak below
# digital full scale.
AUDIO_VOLUME=1000
AUDIO_DRIVE=30
AUDIO_BASS=30
AUDIO_TREBLE=30
AUDIO_LIMITER=true
AUDIO_TARGET_LUFS=-5
AUDIO_DUCK_MUSIC=true
AUDIO_DUCK_LEVEL=0.8

# Mic routing
MIC_GAIN=6
MIC_ROUTE_DEFAULT=mix

# Leave empty to use the bundled ffmpeg-static binary
FFMPEG_PATH=
